# Telegram user account (MTProto, https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Notification bot (@BotFather) and your numeric Telegram ID (@userinfobot)
NOTIFY_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# OpenRouter (https://openrouter.ai/keys) — review + response generation
OPENROUTER_API_KEY=
# например: google/gemini-2.5-flash-lite
OPENROUTER_MODEL=
# JEV (TypeSafe typed-decision model) работает через OpenRouter с тем же OPENROUTER_API_KEY; модель в config.ini [jev] model
JEV_FALLBACK_TO_OPENROUTER=true
# Thresholds
NOTIFY_SCORE=65
HIGH_FIT_SCORE=80
SHOW_PAID_CONTACT=false
DATABASE_URL=sqlite:///data/app.db
